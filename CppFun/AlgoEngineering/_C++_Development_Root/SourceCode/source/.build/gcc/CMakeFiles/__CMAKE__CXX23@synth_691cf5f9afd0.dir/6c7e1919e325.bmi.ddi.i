                    _RandomAccessIterator1 __i1 = __first + (__i - __d_first);
                    _RandomAccessIterator1 __j1 = __first + (__j - __d_first);



                    __internal::__brick_copy(__i1, __j1, __i, _IsVector{});




                    std::sort(__i, __j, __comp);
