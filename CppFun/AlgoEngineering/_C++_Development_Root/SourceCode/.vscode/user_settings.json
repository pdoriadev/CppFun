{
  /**********************************************************
  ** Copy and then rename this file to:
  **   Linux:    ~/.config/Code/User/settings.json
  **   WSL:      ~/.vscode-server/data/Machine/settings.json
  **   Windows:  %APPDATA%\Code\User\settings.json  (e.g. C:\Users\admin\AppData\Roaming\Code\User\settings.json)
  ** This file adds to or alters the default VSCode settings
  ***********************************************************/

  /**********************************************************
  ** User unique values ()
  ***********************************************************/
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_path": "/usr/bin/clang-format",
  "files.hotExit": "off",
  // "terminal.external.linuxExec": "konsole",  // KDE Linux users should uncomment this line




  /**********************************************************
  ** Workspace values
  ** A workspace file in ./.vscode/settings.json, if present,
  ** overrides these values
  ***********************************************************/
  "cSpell.words": [
    "CPSC",
    "CSUF",
    "pseudocode",
    "Tuffix"
  ],
  "cSpell.enabledFiletypes": [
    "shellscript"
  ],
  "editor.detectIndentation": false,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": false,
  "editor.formatOnType": true,
  "editor.hover.enabled": false,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,
  "editor.renderIndentGuides": false,
  "editor.guides.indentation": false,
  "editor.hover.sticky": false,
  "editor.stickyScroll.enabled": false,
  "editor.suggest.showStatusBar": true,
  "editor.tabSize": 2,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "telemetry.telemetryLevel": "off",
  "telemetry.enableTelemetry": false,               // deprecated but some extensions still check the legacy flags
  "telemetry.enableCrashReporter": false,           // deprecated but some extensions still check the legacy flags
  "terminal.integrated.copyOnSelection": true,
  "window.zoomLevel": 2,
  "window.titleBarStyle": "custom",
  "workbench.colorTheme": "Visual Studio Dark",
  "workbench.iconTheme": "vscode-icons",
  "workbench.welcomePage.experimental": false,
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "github.copilot.enable": false,
  "github.copilot.chat.enable": false,
  "chat.disableAIFeatures": true,
  "chat.editing.enable": false,
  "chat.inline.enable": false,
